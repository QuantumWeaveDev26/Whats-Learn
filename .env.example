RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local testing with pnpm start: BILLING_ADMIN_EMAIL=seedy@sites.test (the local test user)
BILLING_ADMIN_EMAIL=
# Paid checkout (see docs/go-live-setup.md)
BILLING_PUBLIC_CHECKOUT=
# Leave empty: real payments stay off. Only true together with an rzp_live_ key takes real money.
BILLING_LIVE_ENABLED=
RAZORPAY_SPRINT_CREDIT_OFFER_ID=
# Live AI review: set ONE provider key (or both and choose with AI_PROVIDER)
# AI_PROVIDER: openai or claude (anthropic also works); leave empty to auto-detect
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_FEEDBACK_DAILY_LIMIT=
AI_FEEDBACK_DAILY_LIMIT_PAID=
# WhatsApp lessons and reminders
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
REMINDER_CRON_SECRET=
# v50: n8n WhatsApp workflows. Shared signing secret between n8n and WhatsLearn (at least 32 random characters). Set it as a host secret here AND in n8n (WHATSLEARN_BRIDGE_SECRET). Leave empty to keep the bridge off.
N8N_BRIDGE_SECRET=
SITE_URL=
# Points a new signed-in account starts with, granted once per account. Whole number 0 to 10000. Empty means 50. Guests get none.
STARTING_POINTS=
# ---- v40: regular-website accounts (email, password) through a managed provider (Supabase Auth). Leave empty on OpenAI Sites (ChatGPT sign-in is used there). See docs/deployment-guide.md.
# Project address, https only (http is accepted only for 127.0.0.1 / localhost when testing on your own computer)
SUPABASE_URL=
# The provider's public (publishable / anon) key. Safe to expose in principle, but keep it in settings, not in code.
SUPABASE_PUBLISHABLE_KEY=
# OPTIONAL SECRET. Lets "Delete my account" also remove the login at the provider. Never put it in code or the browser. Set it as a host secret.
SUPABASE_SERVICE_ROLE_KEY=
# SITE_URL (above) must be your https address, for example https://whatslearn.in. Links in emails are built from it.
# Free-membership reward for the 10-day no-clue title. Stays OFF until BOTH are set. REWARD_PLAN is a plan key (sprint, plus_monthly, plus_annual, pro_monthly, pro_annual, teams_monthly); REWARD_DAYS is 1 to 366.
REWARD_PLAN=
REWARD_DAYS=
# Private file uploads for practical work. Stays OFF unless this is true AND a private R2 bucket is bound as BUCKET.
UPLOADS_ENABLED=
# Build-time only (not secret): your Cloudflare D1 database id/name and R2 bucket name, used to generate the deploy configuration.
CF_D1_DATABASE_ID=
CF_D1_DATABASE_NAME=
CF_R2_BUCKET_NAME=
# Node hosting: optional absolute persistent directory, outside deployment releases.
# Defaults to $HOME/.whatslearn. See docs/hostinger-node.md.
WHATSLEARN_DATA_DIR=
