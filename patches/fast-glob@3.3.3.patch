--- /dev/null
+++ b/out/utils/bounded-expansion.js
@@ -0,0 +1,32 @@
+"use strict";
+
+// Replace the braces/micromatch expansion path with bounded brace-expansion.
+// Matching and scanning use the same picomatch API as micromatch previously did.
+const { expand } = require("brace-expansion");
+const MAX_LENGTH = 10000;
+const MAX_DEPTH = 128;
+const MAX_RESULTS = 1000;
+
+module.exports = pattern => {
+    if (typeof pattern !== "string") throw new TypeError("Expected a glob string");
+    if (pattern.length > MAX_LENGTH || pattern.includes("\0")) throw new SyntaxError("Glob pattern exceeds safe input limits");
+    const protectedParts = [];
+    const input = pattern.replace(/\\[\s\S]|"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/g, value => {
+        const quoted = value[0] === '"' || value[0] === "'";
+        protectedParts.push(quoted ? value.slice(1, -1) : value);
+        return "\0WL" + (protectedParts.length - 1) + "\0";
+    });
+    let braceDepth = 0, parenDepth = 0;
+    for (const character of input) {
+        if (character === "{") braceDepth++;
+        if (character === "(") parenDepth++;
+        if (braceDepth + parenDepth > MAX_DEPTH) throw new SyntaxError("Glob pattern exceeds maximum nesting depth (128)");
+        if (character === "}") braceDepth = Math.max(0, braceDepth - 1);
+        if (character === ")") parenDepth = Math.max(0, parenDepth - 1);
+    }
+    // Preserve non-expansion strings exactly, as micromatch.braces did.
+    if (!pattern.includes("{") || !pattern.includes("}")) return [pattern];
+    const result = expand(input, { max: MAX_RESULTS + 1, maxLength: (MAX_LENGTH + 1) * (MAX_RESULTS + 1), maxDepth: MAX_DEPTH, maxRewrites: MAX_DEPTH });
+    if (result.length > MAX_RESULTS) throw new SyntaxError("Glob pattern exceeds maximum expansions (1000)");
+    return [...new Set(result.map(value => value.replace(/\0WL(\d+)\0/g, (_, index) => protectedParts[Number(index)])))];
+};
