new file mode 100644
index 0000000000000000000000000000000000000000..09ace0f81981ef5d34aff2356c84d9f300e887a2
--- /dev/null
+++ b/lib/assert-safe-ast.js
@@ -0,0 +1,26 @@
+'use strict';
+
+// Local defence for CVE-2026-93687. Keep recursion bounded even for supplied ASTs.
+const MAX_DEPTH = 128;
+const MAX_NODES = 32768;
+const assertSafeAst = ast => {
+  const pending = [{ node: ast, depth: 0, leave: false }];
+  const ancestors = new Set();
+  let visited = 0;
+  while (pending.length) {
+    const { node, depth, leave } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (leave) { ancestors.delete(node); continue; }
+    if (depth > MAX_DEPTH) throw new SyntaxError('Brace pattern exceeds maximum nesting depth (128)');
+    if (++visited > MAX_NODES) throw new SyntaxError('Brace pattern exceeds maximum AST nodes (32768)');
+    if (ancestors.has(node)) throw new SyntaxError('Cyclic brace AST is not supported');
+    ancestors.add(node);
+    pending.push({ node, depth, leave: true });
+    if (Array.isArray(node.nodes)) {
+      if (node.nodes.length > MAX_NODES - visited) throw new SyntaxError('Brace pattern exceeds maximum AST nodes (32768)');
+      for (let i = node.nodes.length - 1; i >= 0; i--) pending.push({ node: node.nodes[i], depth: depth + 1, leave: false });
+    }
+  }
+};
+assertSafeAst.MAX_DEPTH = MAX_DEPTH;
+module.exports = assertSafeAst;
